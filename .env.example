# Secrets belong in .dev.vars for Wrangler; never in VITE_* variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Apps Script endpoint that writes Sheets, reads Google free/busy, sends confirmations.
INTEGRATION_URL=
INTEGRATION_SECRET=
# Native remote backend origin. Browser uses same-origin /api.
VITE_API_URL=
# Optional provider adapter for FCM/APNs delivery.
PUSH_GATEWAY_URL=
PUSH_GATEWAY_SECRET=

# Production independent auth; generate an owner setup secret before publishing.
AUTH_ENABLED=true
ADMIN_SETUP_SECRET=
