{
  "name": "questbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/node-runtime.mjs node_modules/wrangler/bin/wrangler.js dev --port 8787",
    "dev:ui": "node scripts/node-runtime.mjs node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node scripts/node-runtime.mjs --run build:app",
    "test": "node scripts/node-runtime.mjs --import tsx --test tests/*.test.ts",
    "db:migrate": "node scripts/node-runtime.mjs node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --local",
    "mobile:sync": "npm run build && node scripts/node-runtime.mjs node_modules/@capacitor/cli/bin/capacitor sync",
    "mobile:android": "node scripts/node-runtime.mjs node_modules/@capacitor/cli/bin/capacitor open android",
    "mobile:ios": "node scripts/node-runtime.mjs node_modules/@capacitor/cli/bin/capacitor open ios",
    "install:ci": "npm install",
    "local": "node scripts/node-runtime.mjs scripts/local-server.mjs",
    "lan": "node scripts/node-runtime.mjs scripts/local-server.mjs --lan",
    "build:app": "node scripts/prepare-data.mjs && tsc --noEmit && vite build && node scripts/build-server.mjs && node scripts/build-local.mjs",
    "test:local": "node tests/local-runtime-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "wrangler": "^4.165.0",
    "miniflare": "5.20261118.0-beta",
    "@types/sql.js": "^1.4.9"
  },
  "engines": {
    "node": ">=24"
  }
}
